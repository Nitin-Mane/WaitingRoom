{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".firebaserc.local",
      ".firebase/**",
      ".github/**",
      ".git/**",
      ".gitignore",
      "node_modules/**",
      "test/**",
      "README.md",
      "package.json",
      "package-lock.json",
      "*.log",
      "docs/API_AND_STORAGE_SPEC.md",
      "docs/ARCHITECTURE.md",
      "docs/AUTHENTICATION_AND_FIREBASE.md",
      "docs/RECOMMENDATION_ENGINE.md",
      "docs/SCORING_ENGINE.md",
      "docs/USER_GUIDE.md",
      "docs/images/**",
      "firebase-config.example.js"
    ],
    "cleanUrls": false,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|mjs)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      },
      {
        "source": "**/*.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|webp|svg)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
          { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
          { "key": "X-Content-Type-Options", "value": "nosniff" }
        ]
      }
    ]
  }
}
